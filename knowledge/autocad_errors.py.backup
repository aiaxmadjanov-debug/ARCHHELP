def get_autocad_error(error_name):
    return AUTOCAD_ERRORS.get(error_name)


def get_autocad_error_names():
    return list(AUTOCAD_ERRORS.keys())


if __name__ == "__main__":
    print(f"AUTOCAD XATOLARI: {len(AUTOCAD_ERRORS)} ta")