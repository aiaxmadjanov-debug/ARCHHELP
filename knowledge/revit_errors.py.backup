def get_revit_error(error_name):
    return REVIT_ERRORS.get(error_name)


def get_revit_error_names():
    return list(REVIT_ERRORS.keys())


if __name__ == "__main__":
    print(f"REVIT XATOLARI: {len(REVIT_ERRORS)} ta")